general {
    colors = true
    interval = 5
    color_good     = "#ffffff"
    color_degraded = "#ffffff"
    color_bad      = "#ffffff"
}

order += "volume master"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "battery 0"
order += "tztime local"

volume master {
    format = "VOL: %volume"
    format_muted = "VOL: muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

cpu_usage {
    format = "CPU: %usage"
}

memory {
    format = "MEM: %used / %total"
    threshold_degraded = "10%"
    threshold_critical = "5%"
}

disk "/" {
    format = "DISK: %avail free"
}

battery 0 {
    format          = "BAT: %status %percentage"
    format_down     = "No battery"
    status_chr      = "CHR"
    status_bat      = "BAT"
    status_full     = "FULL"
    low_threshold   = 15
    threshold_type  = "percentage"
}

tztime local {
    format = "%d-%m-%Y %H:%M"
}
